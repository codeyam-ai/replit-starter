entrypoint = "scripts/start-codeyam.mjs"
modules = ["nodejs-20"]
run = "npm run codeyam"

# Exactly one published port. Hosted CodeYam resolves its public origin from
# this mapping, so a second entry is ambiguous and none leaves the editor bound
# to a port nothing routes to.
[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

# The Run button target. Replit's Preview panel attaches to the webview
# workflow underneath, not to this one.
[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

# The long-running web workflow. It starts the editor and nothing else:
# installing packages here would make Replit restart the workflow before it
# ever reaches the start, so the port never opens. Dependencies are installed by
# the `Set up CodeYam` workflow below.
[[workflows.workflow]]
name = "Start application"
author = "codeyam"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run codeyam"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

# First-run setup: install the editor, initialize it, verify it. Run it once on
# a fresh import, then press Run -- Run refuses to start before setup and names
# this workflow. It installs packages, so Replit may restart it mid-run; that is
# safe, because every phase checks whether it is already done and a re-run
# resumes where the last one stopped. Never reachable from the Run button.
[[workflows.workflow]]
name = "Set up CodeYam"
author = "codeyam"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run bootstrap"
